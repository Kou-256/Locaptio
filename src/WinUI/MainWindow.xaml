<Window x:Class="Locaptio.WinUI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Locaptio.WinUI" Title="Locaptio">
 <Grid x:Name="Root" AllowDrop="True" DragOver="AudioDragOver" Drop="AudioDrop" RequestedTheme="Dark" Background="#363636" Padding="12" RowSpacing="6">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <MenuBar x:Name="HeaderMenu" RequestedTheme="Light" Background="#F5F7FA" Margin="-12,-12,-12,0" Padding="6,0" MinHeight="32" AutomationProperties.Name="メニューバー">
   <MenuBar.Resources><Style TargetType="MenuBarItem"><Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="10,4"/><Setter Property="MinHeight" Value="30"/></Style></MenuBar.Resources>
   <MenuBarItem Title="ファイル(F)">
    <MenuFlyoutItem x:Name="HomeMenuItem" Text="ホームに戻る" Click="HomeClick"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE80F;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
    <MenuFlyoutSeparator/>
    <MenuFlyoutItem Text="テキストを保存…" Click="SaveClick"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74E;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
    <MenuFlyoutItem x:Name="SubtitlesMenuItem" Text="字幕ファイル（SRT・VTT）を書き出す…" Click="ExportSubtitlesClick"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7F0;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
    <MenuFlyoutItem x:Name="CopyMenuItem" Text="全文をコピー" Click="CopyTranscriptClick"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
    <MenuFlyoutSeparator/>
    <MenuFlyoutItem Text="録音と文字起こしを開く…" Click="OpenRecordingClick"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
    <MenuFlyoutItem Text="音声ファイルから文字起こし…" Click="ImportAudioClick"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E5;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
    <MenuFlyoutItem x:Name="RecoverMenuItem" Text="前回の未保存セッションを復元…" Click="RecoverSessionClick" IsEnabled="False"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE81C;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
    <MenuFlyoutSeparator/>
    <MenuFlyoutItem Text="終了" Click="CloseClick"/>
   </MenuBarItem>
   <MenuBarItem Title="編集(E)">
    <MenuFlyoutItem x:Name="UndoMenuItem" Text="修正を元に戻す" Click="UndoEditClick" IsEnabled="False" KeyboardAcceleratorTextOverride="Ctrl+Z"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7A7;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
    <MenuFlyoutItem x:Name="RedoMenuItem" Text="修正をやり直す" Click="RedoEditClick" IsEnabled="False" KeyboardAcceleratorTextOverride="Ctrl+Y"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7A6;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
    <MenuFlyoutSeparator/>
    <MenuFlyoutItem x:Name="EditMenuItem" Text="選択した発話を編集…" Click="EditSelectedClick" KeyboardAcceleratorTextOverride="F2"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70F;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
    <MenuFlyoutItem x:Name="ChangesMenuItem" Text="変更された発話・補正前の原文と比較…" Click="ShowChangesClick"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8F1;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
    <MenuFlyoutSeparator/>
    <MenuFlyoutItem x:Name="BookmarkMenuItem" Text="ブックマークを付ける" Click="BookmarkMenuClick" KeyboardAcceleratorTextOverride="Ctrl+B"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE734;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
    <MenuFlyoutItem Text="用語辞書を編集…" Click="TermDictionaryClick"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE82D;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
   </MenuBarItem>
   <MenuBarItem Title="聞き取り(T)">
    <MenuFlyoutItem Text="開始" Click="StartClick"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE768;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
    <MenuFlyoutItem Text="停止" Click="StopClick"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71A;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
    <MenuFlyoutItem x:Name="ClearMenuItem" Text="表示中の文章をクリア" Click="ClearClick"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
   </MenuBarItem>
   <MenuBarItem Title="録音・AI(R)">
    <MenuFlyoutItem Text="録音一覧・再生…" Click="OpenRecordingClick"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
    <MenuFlyoutItem x:Name="RetranscribeMenuItem" Text="別のモデルで再文字起こし…" Click="RetranscribeClick"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72C;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
    <MenuFlyoutItem x:Name="SyncMenuItem" Text="音声と文章の同期を改善（単語時刻を付ける）…" Click="ImproveTimingClick"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE916;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
    <MenuFlyoutItem x:Name="VersionsMenuItem" Text="文字起こしの版を比較・切り替え…" Click="VersionsClick"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE81C;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
    <MenuFlyoutSeparator/>
    <MenuFlyoutItem x:Name="BurnSubtitlesMenuItem" Text="字幕付き動画を書き出す…" Click="BurnSubtitlesClick"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE714;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
    <ToggleMenuFlyoutItem x:Name="LiveSummaryMenuItem" Text="ライブ要約（録音・文字起こし中に自動で要約）" Click="LiveSummaryClick"><ToggleMenuFlyoutItem.Icon><ImageIcon Source="ms-appx:///Assets/Icons/live-summary.svg"/></ToggleMenuFlyoutItem.Icon></ToggleMenuFlyoutItem>
    <MenuFlyoutItem x:Name="SummaryMenuItem" Text="AIで要約（要点・決定事項・TODO）" Click="SummaryClick"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8FD;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
   </MenuBarItem>
   <MenuBarItem Title="設定(S)">
    <MenuFlyoutItem Text="設定を開く…" Click="SettingsClick"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE713;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
    <ToggleMenuFlyoutItem x:Name="KeepOnTopMenuItem" Text="常に手前に表示" Click="KeepOnTopMenuClick"/>
   </MenuBarItem>
   <MenuBarItem Title="ヘルプ(H)">
    <MenuFlyoutItem Text="モデルの説明" Click="ModelHelpClick"/>
    <MenuFlyoutItem Text="更新を確認" Click="CheckUpdatesClick"/>
    <MenuFlyoutItem Text="このアプリについて" Click="AboutClick"/>
    <MenuFlyoutSeparator/>
    <MenuFlyoutItem Text="問題を報告（GitHub）…" Click="ReportIssueClick"/>
    <MenuFlyoutItem Text="クラッシュレポートを表示…" Click="CrashReportClick"/>
   </MenuBarItem>
  </MenuBar>
  <StackPanel Grid.Row="1" Spacing="6">
  <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><local:DownwardSelector x:Name="ModeSelector" Width="170" HorizontalAlignment="Left" SelectionChanged="ModeChanged" AutomationProperties.Name="話す言語" ToolTipService.ToolTip="音声の言語（日本語・英語・イタリア語・スペイン語）。切り替え前にテキストの保存を確認します。"></local:DownwardSelector><local:DownwardSelector x:Name="TargetSelector" Grid.Column="1" Width="200" HorizontalAlignment="Left" SelectionChanged="ModeChanged" AutomationProperties.Name="翻訳" ToolTipService.ToolTip="文字起こしのみ、または翻訳先の言語。英語→日本語以外は設定でダウンロードする翻訳モデルを使います。"></local:DownwardSelector><local:DownwardSelector x:Name="AudioSelector" Grid.Column="2" HorizontalAlignment="Stretch" MaxWidth="500" SelectionChanged="AudioChanged" DropDownOpened="AudioMenuOpened" AutomationProperties.Name="音声入力" ToolTipService.ToolTip="Windows字幕連携ではPC内音声／PC内音声＋マイクを選択し、Windows側のマイク設定も自動で切り替えます。Whisperではマイク単独・指定アプリも選べます。入力を切り替えても会話履歴は保持します。録音中は同じ録音フォルダーの別ファイルに分割します。"/></Grid>
  <local:ToolbarPanel x:Name="MainToolbar" RightTapped="ToolbarRightTapped">
   <local:ToolbarPanel.Resources>
    <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}"><Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="10,4"/><Setter Property="FontSize" Value="14"/><Setter Property="CornerRadius" Value="4"/></Style>
    <Style x:Key="PrimaryToolbarButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}"><Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="14,4"/><Setter Property="FontSize" Value="14"/><Setter Property="CornerRadius" Value="4"/></Style>
    <Style TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}"><Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="10,4"/><Setter Property="FontSize" Value="14"/><Setter Property="CornerRadius" Value="4"/></Style>
    <Style TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}"><Setter Property="local:CheckBoxGlyph.Static" Value="True"/><Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="32"/><Setter Property="FontSize" Value="14"/><Setter Property="CornerRadius" Value="4"/></Style>
    <Style TargetType="FontIcon"><Setter Property="FontSize" Value="14"/></Style>
   </local:ToolbarPanel.Resources>
   <Button x:Name="StartButton" Style="{StaticResource PrimaryToolbarButton}" Click="StartClick" AutomationProperties.Name="開始" ToolTipService.ToolTip="選んだ音声の文字起こしを開始します。"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE768;"/><TextBlock Text="開始"/></StackPanel></Button>
   <Button x:Name="StopButton" Click="StopClick" IsEnabled="False" AutomationProperties.Name="停止" ToolTipService.ToolTip="文字起こしと録音を停止します。表示中の文章は残ります。"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE71A;"/><TextBlock Text="停止"/></StackPanel></Button>
   <Button x:Name="ClearButton" Click="ClearClick" IsEnabled="False" AutomationProperties.Name="クリア" ToolTipService.ToolTip="表示中の文章を消します。消す前に保存するか確認します。見返し中の録音・録画も閉じます。保存済みの録音やファイルは削除しません。"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE74D;"/><TextBlock Text="クリア"/></StackPanel></Button>
   <Button x:Name="HomeButton" Click="HomeClick" IsEnabled="False" AutomationProperties.Name="ホーム" ToolTipService.ToolTip="最初の画面に戻ります。見返し中の録音・録画と文章を閉じます（ファイルは削除しません）。保存していない文章は、閉じる前に保存するか確認します。"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE80F;"/><TextBlock Text="ホーム"/></StackPanel></Button>
   <Button x:Name="CaptionButton" Click="CaptionClick" AutomationProperties.Name="字幕ウィンドウ" ToolTipService.ToolTip="キャプションだけのウィンドウを開閉します。移動は字幕の背景をドラッグしてください。"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE7F0;"/><TextBlock x:Name="CaptionButtonText" Text="字幕"/></StackPanel></Button>
   <ToggleButton x:Name="RecordToggle" Checked="RecordChanged" Unchecked="RecordChanged" AutomationProperties.Name="新規録音" ToolTipService.ToolTip="新しい録音を専用フォルダーに保存します。もう一度押すと録音・文字起こしを停止します。保存済みデータは録音一覧から開いてください。"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE7C8;" Foreground="#FF7A7A"/><TextBlock x:Name="RecordToggleText" Text="新規録音"/></StackPanel></ToggleButton>
   <ToggleButton x:Name="VideoToggle" Click="VideoToggleClick" AutomationProperties.Name="新規録画" ToolTipService.ToolTip="画面全体または選んだウィンドウを、音声と一緒にMP4で録画します。録画しながら文字起こしもでき、あとから字幕付き動画を書き出せます。"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE714;" Foreground="#FF7A7A"/><TextBlock x:Name="VideoToggleText" Text="新規録画"/></StackPanel></ToggleButton>
   <SplitButton x:Name="BookmarkButton" Click="BookmarkClick" MinHeight="32" Padding="10,4" FontSize="14" AutomationProperties.Name="ブックマークを付ける" ToolTipService.ToolTip="いまの時刻・発話に印を付けます（Ctrl+B）。▼で「後で確認」などの種類を選べます。録音中は聞き直し位置として保存します。"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon x:Name="BookmarkButtonIcon" Glyph="&#xE735;" Foreground="#F5B942"/><TextBlock x:Name="BookmarkButtonText" Text="重要"/></StackPanel></SplitButton>
   <Button x:Name="SaveButton" Click="SaveClick" IsEnabled="False" AutomationProperties.Name="テキスト保存" ToolTipService.ToolTip="表示中の文字起こしをテキストファイルに保存します。"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE74E;"/><TextBlock Text="テキスト保存"/></StackPanel></Button>
   <DropDownButton x:Name="MoreButton" MinHeight="32" Padding="10,4" FontSize="14" AutomationProperties.Name="書き出し・AI" ToolTipService.ToolTip="字幕ファイルの書き出し、AI要約、修正の取り消しなど">
    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xEDE1;"/><TextBlock Text="書き出し・AI"/></StackPanel>
    <DropDownButton.Flyout>
     <MenuFlyout Placement="Bottom">
      <MenuFlyoutItem x:Name="MoreSubtitlesItem" Text="字幕ファイル（SRT・VTT）を書き出す…" Click="ExportSubtitlesClick"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7F0;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
      <MenuFlyoutItem x:Name="MoreCopyItem" Text="全文をコピー" Click="CopyTranscriptClick"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
      <MenuFlyoutSeparator/>
      <MenuFlyoutItem x:Name="MoreSummaryItem" Text="AIで要約（要点・決定事項・TODO）" Click="SummaryClick"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8FD;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
      <MenuFlyoutItem x:Name="MoreChangesItem" Text="変更された発話・補正前の原文と比較…" Click="ShowChangesClick"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8F1;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
      <MenuFlyoutItem Text="用語辞書を編集…" Click="TermDictionaryClick"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE82D;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
     </MenuFlyout>
    </DropDownButton.Flyout>
   </DropDownButton>
   <Button x:Name="LibraryButton" Click="OpenRecordingClick" AutomationProperties.Name="録音一覧・再生" ToolTipService.ToolTip="保存済みの音声とテキストを開きます。新しい録音は開始しません。"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8B7;"/><TextBlock Text="録音一覧"/></StackPanel></Button>
   <Button x:Name="ImportButton" Click="ImportAudioClick" AutomationProperties.Name="音声ファイル読込" ToolTipService.ToolTip="MP3・M4A・WAVの音声やMP4・MOVなどの動画をローカルで文字起こし。ドラッグ＆ドロップにも対応。原本は変更しません。"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8E5;"/><TextBlock Text="ファイル読込"/></StackPanel></Button>
   <local:FeatureSwitch x:Name="AiCorrectionToggle" Label="AI補正" MinWidth="0" Click="AiCorrectionChanged" AutomationProperties.Name="文字起こしをAIで補正" ToolTipService.ToolTip="文字起こしをローカルAIで補正します。Windows連携は即時反映、Whisperは次回の開始から。LLM環境・既定モデルがない場合は初回のみ自動取得します（ネット接続・数GBの空き容量が必要）。"/>
   <local:FeatureSwitch x:Name="LiveSummaryToggle" Label="ライブ要約" MinWidth="0" Click="LiveSummaryToggleClick" AutomationProperties.Name="ライブ要約" ToolTipService.ToolTip="録音・文字起こし中に、数分ごとの発話をローカルAIが要約して右の欄に追加します。長くなると古いまとまりは「ここまでの流れ」にまとめ直します。録音中でもON/OFFできます。"/>
   <Button x:Name="SearchButton" Click="SearchRecordingClick" AutomationProperties.Name="録音内の文字を検索" ToolTipService.ToolTip="録音の文字起こしを検索し、その発話から再生"><FontIcon Glyph="&#xE721;"/></Button>
  </local:ToolbarPanel></StackPanel>
  <StackPanel Grid.Row="2" Spacing="4">
  <TextBlock x:Name="SessionTitle" Text="文字起こし（録音なし）／音声も残すときは「新規録音」、保存済みデータは「録音一覧」から" FontSize="11" TextWrapping="Wrap"/>
  <Grid x:Name="RecordingIndicator" Visibility="Collapsed" ColumnSpacing="8">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Border x:Name="LivePreviewFrame" Visibility="Collapsed" Width="160" Height="90" CornerRadius="4" Background="Black" BorderBrush="#FF8F8F" BorderThickness="1" ToolTipService.ToolTip="録画中の映像（プレビュー）">
    <Image x:Name="LivePreview" Stretch="Uniform"/>
   </Border>
   <TextBlock x:Name="RecordingLabel" Grid.Column="1" Text="● 録音中" Foreground="#FF8F8F" VerticalAlignment="Center"/>
   <TextBlock x:Name="RecordingClock" Grid.Column="2" FontFamily="Consolas" Foreground="#FF8F8F" VerticalAlignment="Center"/>
   <TextBlock x:Name="RecordingText" Grid.Column="3" Foreground="#FF8F8F" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
   <StackPanel x:Name="VideoControls" Grid.Column="4" Orientation="Horizontal" Spacing="6" Visibility="Collapsed" VerticalAlignment="Center">
    <Button x:Name="VideoPauseButton" Click="VideoPauseClick" Padding="8,3" FontSize="12" AutomationProperties.Name="録画を一時停止" ToolTipService.ToolTip="録画を一時停止・再開します。一時停止中の映像と発話は動画に入りません。"><StackPanel Orientation="Horizontal" Spacing="5"><FontIcon x:Name="VideoPauseIcon" Glyph="&#xE769;" FontSize="12"/><TextBlock x:Name="VideoPauseText" Text="一時停止"/></StackPanel></Button>
    <Button x:Name="ScreenshotButton" Click="ScreenshotClick" Padding="8,3" FontSize="12" AutomationProperties.Name="スクリーンショット" ToolTipService.ToolTip="録画中の画面を画像（PNG）で録画フォルダーに保存し、その時刻にブックマークを付けます。"><StackPanel Orientation="Horizontal" Spacing="5"><FontIcon Glyph="&#xE722;" FontSize="12"/><TextBlock Text="スクリーンショット"/></StackPanel></Button>
   </StackPanel>
  </Grid>
  <StackPanel x:Name="PlaybackPanel" Visibility="Collapsed" Spacing="4">
   <Grid x:Name="VideoPanel" Visibility="Collapsed" Height="300" Background="Black" CornerRadius="6" Tapped="VideoTapped" AutomationProperties.Name="録画した動画">
    <MediaPlayerElement x:Name="VideoPlayer" AreTransportControlsEnabled="False" Stretch="Uniform"/>
    <Image x:Name="VideoStill" Visibility="Collapsed" Stretch="Uniform" IsHitTestVisible="False"/>
    <Border x:Name="VideoCaption" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="12,0,12,14" Padding="14,6" CornerRadius="6" Background="#C8202020" MaxWidth="980" IsHitTestVisible="False">
     <TextBlock x:Name="VideoCaptionText" Foreground="White" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/>
    </Border>
   </Grid>
   <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Button x:Name="PlaybackButton" Content="再生" Click="PlaybackClick" Padding="8,3" FontSize="12"/>
    <Slider x:Name="PlaybackPosition" Grid.Column="1" Minimum="0" Maximum="1" ValueChanged="PlaybackSeekChanged" AutomationProperties.Name="録音の再生位置"/>
    <TextBlock x:Name="PlaybackTime" Grid.Column="2" VerticalAlignment="Center" FontSize="12" FontFamily="Consolas"/>
   </Grid>
   <local:ToolbarPanel x:Name="RecordingTools">
    <local:ToolbarPanel.Resources>
     <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}"><Setter Property="Padding" Value="8,3"/><Setter Property="FontSize" Value="12"/><Setter Property="CornerRadius" Value="4"/></Style>
     <Style TargetType="FontIcon"><Setter Property="FontSize" Value="12"/></Style>
    </local:ToolbarPanel.Resources>
    <Button x:Name="RetranscribeButton" Click="RetranscribeClick" ToolTipService.ToolTip="この録音を別のモデルや高精度設定で認識し直し、現在の結果と並べて比較します。元の結果は残ります。"><StackPanel Orientation="Horizontal" Spacing="5"><FontIcon Glyph="&#xE72C;"/><TextBlock Text="再文字起こし…"/></StackPanel></Button>
    <Button x:Name="SyncButton" Click="ImproveTimingClick" ToolTipService.ToolTip="音声をもう一度解析し、いまの文章に単語ごとの時刻を付けます。ハイライトとクリック再生のずれを減らします。文章は変えません。"><StackPanel Orientation="Horizontal" Spacing="5"><FontIcon Glyph="&#xE916;"/><TextBlock Text="同期を改善"/></StackPanel></Button>
    <Button x:Name="VersionsButton" Click="VersionsClick" ToolTipService.ToolTip="以前の文字起こし結果と比較し、切り替えます。"><StackPanel Orientation="Horizontal" Spacing="5"><FontIcon Glyph="&#xE81C;"/><TextBlock Text="版を比較・切替"/></StackPanel></Button>
    <Button x:Name="SummaryToolButton" Click="SummaryClick" ToolTipService.ToolTip="ローカルAIで要点・決定事項・TODOを作ります。各項目から根拠の発話へ戻れます。"><StackPanel Orientation="Horizontal" Spacing="5"><FontIcon Glyph="&#xE8FD;"/><TextBlock Text="AI要約"/></StackPanel></Button>
    <Button x:Name="BurnSubtitlesButton" Click="BurnSubtitlesClick" Visibility="Collapsed" ToolTipService.ToolTip="字幕を映像に焼き込んだ新しいMP4を書き出します。元の動画は変更しません。"><StackPanel Orientation="Horizontal" Spacing="5"><FontIcon Glyph="&#xE7F0;"/><TextBlock Text="字幕付き動画を書き出す…"/></StackPanel></Button>
    <Button x:Name="SubtitlesToolButton" Click="ExportSubtitlesClick" ToolTipService.ToolTip="動画編集や字幕表示に使えるSRT・VTTファイルを保存します。"><StackPanel Orientation="Horizontal" Spacing="5"><FontIcon Glyph="&#xE7F0;"/><TextBlock Text="SRT・VTT"/></StackPanel></Button>
   </local:ToolbarPanel>
   <TextBlock x:Name="PlaybackHint" Text="文字をクリックすると、その発話の少し前から再生します。ドラッグで選択・コピーもできます。" FontSize="11" TextWrapping="Wrap"/>
  </StackPanel>
  <ScrollViewer x:Name="BookmarkScroll" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Auto" VerticalScrollMode="Disabled" AutomationProperties.Name="ブックマーク一覧">
   <StackPanel x:Name="BookmarkPanel" Orientation="Horizontal" Spacing="6" Padding="0,0,0,2"/>
  </ScrollViewer>
  <StackPanel x:Name="RecordingSearchPanel" Visibility="Collapsed" Spacing="4">
   <TextBox x:Name="RecordingSearch" PlaceholderText="録音内の言葉を検索" TextChanged="RecordingSearchChanged" AutomationProperties.Name="録音内の検索語"/>
   <TextBlock x:Name="RecordingSearchCount" FontSize="11"/>
   <ListView x:Name="RecordingSearchResults" MaxHeight="96" IsItemClickEnabled="True" SelectionMode="None" ItemClick="RecordingSearchResultClick">
    <ListView.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding Time}" FontFamily="Consolas"/><TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ListView.ItemTemplate>
   </ListView>
  </StackPanel>
  </StackPanel>
  <Grid x:Name="Header" Grid.Row="3" ColumnSpacing="20" Padding="10,0,26,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock x:Name="EnglishHeader" Text="English" Foreground="#C8C8C8"/><TextBlock x:Name="JapaneseHeader" Grid.Column="1" Text="日本語" Foreground="#C8C8C8"/></Grid>
  <ListView x:Name="CaptionList" Grid.Row="4" SelectionMode="None" IsItemClickEnabled="False" Padding="0" ContainerContentChanging="CaptionContainerChanging" Loaded="CaptionListLoaded" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
   <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel ItemsUpdatingScrollMode="KeepItemsInView"/></ItemsPanelTemplate></ListView.ItemsPanel>
   <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="MinHeight" Value="0"/><Setter Property="IsTabStop" Value="False"/></Style></ListView.ItemContainerStyle>
   <!-- Children 0 and 1 are the text columns used by selection and playback. Child 2 is the bookmark bar, child 3 the edited mark. -->
   <ListView.ItemTemplate><DataTemplate><Grid ColumnSpacing="20" Padding="10,0,26,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{Binding English}" TextWrapping="Wrap" IsTextSelectionEnabled="False" SelectionChanged="CaptionSelectionChanged" Unloaded="CaptionTextUnloaded"/><TextBlock Grid.Column="1" Text="{Binding Japanese}" TextWrapping="Wrap" IsTextSelectionEnabled="False" SelectionChanged="CaptionSelectionChanged" Unloaded="CaptionTextUnloaded"/><Border Grid.ColumnSpan="2" HorizontalAlignment="Left" Width="5" Margin="-10,3,0,3" CornerRadius="2" Background="#F5B942" Visibility="Collapsed"/><FontIcon Grid.ColumnSpan="2" Glyph="&#xE70F;" FontSize="11" Foreground="#9AA0A6" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,-20,0" Visibility="Collapsed"/><FontIcon Grid.ColumnSpan="2" Glyph="&#xE7BA;" FontSize="12" Foreground="#F59E0B" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,22,-21,0" Visibility="Collapsed"/><Border Grid.ColumnSpan="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,-25,0" Padding="3,0,3,1" CornerRadius="3" Background="#7C5CFF" Visibility="Collapsed"><TextBlock Text="AI" FontSize="9" FontWeight="SemiBold" Foreground="White"/></Border></Grid></DataTemplate></ListView.ItemTemplate>
  </ListView>
  <StackPanel x:Name="EmptyState" Grid.Row="4" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="620" IsHitTestVisible="False">
   <FontIcon Glyph="&#xE720;" FontSize="34" Foreground="#9AA0A6"/>
   <TextBlock Text="「開始」を押すと、PCで流れている音声を文字にします" FontSize="17" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
   <Grid ColumnSpacing="14" RowSpacing="6" HorizontalAlignment="Center">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
    <FontIcon Glyph="&#xE8C1;" FontSize="15" Foreground="#9AA0A6"/><TextBlock Grid.Column="1" FontSize="13" TextWrapping="Wrap" Text="左上で「日本語の文字起こし」か「英語 → 日本語 翻訳」と、聞き取る音声を選びます。"/>
    <FontIcon Grid.Row="1" Glyph="&#xE7C8;" FontSize="15" Foreground="#FF7A7A"/><TextBlock Grid.Row="1" Grid.Column="1" FontSize="13" TextWrapping="Wrap" Text="音声も残すときは「新規録音」。あとで文章をクリックして聞き直せます。"/>
    <FontIcon Grid.Row="2" Glyph="&#xE734;" FontSize="15" Foreground="#F5B942"/><TextBlock Grid.Row="2" Grid.Column="1" FontSize="13" TextWrapping="Wrap" Text="大事なところは「重要」(Ctrl+B)で印を付け、誤認識は右クリックから直せます。"/>
    <FontIcon Grid.Row="3" Glyph="&#xE8E5;" FontSize="15" Foreground="#9AA0A6"/><TextBlock Grid.Row="3" Grid.Column="1" FontSize="13" TextWrapping="Wrap" Text="手元の音声（MP3・M4A・WAV）や動画（MP4・MOVなど）は、この画面にドロップすると文字起こしできます。"/>
   </Grid>
  </StackPanel>
  <Button x:Name="ResumeHistoryButton" Grid.Row="4" Content="最新へ" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,12" Click="ResumeHistoryClick" ToolTipService.ToolTip="最新の字幕へ移動し、自動スクロールを再開します。"/>
  <Thumb x:Name="SummaryResizeGrip" Grid.Row="4" Visibility="Collapsed" HorizontalAlignment="Right" Width="8" Margin="0,24,344,24" DragDelta="SummaryResizeDrag" DragCompleted="SummaryResizeCompleted" Opacity=".55" ToolTipService.ToolTip="ドラッグで要約欄の幅を変更" AutomationProperties.Name="要約欄の幅を変更"/>
  <Border x:Name="SummaryPane" Grid.Row="4" Visibility="Collapsed" HorizontalAlignment="Right" Width="340" Background="#2B2B2B" BorderBrush="#858585" BorderThickness="1" CornerRadius="8" Padding="12,10,8,10" AutomationProperties.Name="AI要約">
   <Grid RowSpacing="8">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8FD;" FontSize="14"/><TextBlock Text="AI要約" FontSize="15" FontWeight="SemiBold"/></StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
     <Button x:Name="SummaryPopOutButton" Click="SummaryPopOutClick" Padding="6,2" Background="Transparent" BorderThickness="0" AutomationProperties.Name="要約を別ウィンドウで開く" ToolTipService.ToolTip="別ウィンドウで開く（大きさを自由に変えられます）"><FontIcon x:Name="SummaryPopOutIcon" Glyph="&#xE8A7;" FontSize="12"/></Button>
     <Button Click="SummaryCloseClick" Padding="6,2" Background="Transparent" BorderThickness="0" AutomationProperties.Name="要約を閉じる"><FontIcon Glyph="&#xE711;" FontSize="11"/></Button></StackPanel>
    </Grid>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0"><StackPanel x:Name="SummaryContent" Spacing="6"/></ScrollViewer>
    <local:ToolbarPanel Grid.Row="2">
     <Button x:Name="SummaryRunButton" Content="作成" Click="SummaryRunClick" Padding="8,3" FontSize="12"/>
     <Button x:Name="SummaryCopyButton" Content="コピー" Click="SummaryCopyClick" Padding="8,3" FontSize="12" IsEnabled="False"/>
     <Button x:Name="SummarySaveButton" Content="Markdown保存…" Click="SummarySaveClick" Padding="8,3" FontSize="12" IsEnabled="False"/>
     <Button x:Name="SummaryLiveClearButton" Content="ライブ要約をクリア" Click="LiveSummaryClearClick" Padding="8,3" FontSize="12" Visibility="Collapsed" ToolTipService.ToolTip="ライブ要約（「ここまでの流れ」を含む）を消します。文章と全体の要約は残ります。"/>
    </local:ToolbarPanel>
   </Grid>
  </Border>
  <StackPanel Grid.Row="5" Spacing="3">
   <TextBlock x:Name="WindowsOperationText" Text="ライブキャプション操作中" Visibility="Collapsed" FontSize="12" AutomationProperties.LiveSetting="Polite"/>
   <InfoBar x:Name="CrashNotice" Severity="Warning" IsOpen="False" IsClosable="True" Title="前回、Locaptio が予期せず終了しました" Message="原因の調査に使う情報（クラッシュレポート）を保存しました。内容はPC内にだけあり、自動で送信はしません。"><InfoBar.ActionButton><Button Content="レポートを表示…" Click="CrashReportClick"/></InfoBar.ActionButton></InfoBar>
   <InfoBar x:Name="RecoveryNotice" Severity="Informational" IsOpen="False" IsClosable="True" Title="前回の未保存の文字起こしがあります"><InfoBar.ActionButton><Button Content="内容を確認して復元…" Click="RecoverSessionClick"/></InfoBar.ActionButton></InfoBar>
   <InfoBar x:Name="UpdateNotice" Severity="Informational" IsOpen="False" IsClosable="True" Title="アプリの更新"/>
   <InfoBar x:Name="WindowsCaptionWarning" Severity="Warning" IsOpen="False" IsClosable="False" Title="Windowsライブキャプションとの接続が切れました"/>
   <InfoBar x:Name="WindowsLanguageWarning" Severity="Warning" IsOpen="False" IsClosable="True" Title="Windows字幕の言語を確認してください"/>
   <InfoBar x:Name="WindowsMicrophoneNotice" Severity="Informational" IsOpen="False" IsClosable="True" Title="Windows字幕でマイクを使うには" Message="Windowsライブキャプションの設定 → 基本設定 → マイク音声を含めるをONにしてください。Windowsの既定の入力を使用し、PC音声と重なるとPC音声が優先されます。マイクのアクセス許可が必要な場合はWindows側で許可してください。"/>
   <StackPanel x:Name="PreparationPanel" Spacing="3" Visibility="Collapsed" ToolTipService.ToolTip="割合は完了した準備工程の割合です。残り時間やNPUコンパイル内部の進捗を推測した値ではありません。">
    <TextBlock x:Name="PreparationText" FontSize="12" Foreground="#FFFFFF" TextWrapping="Wrap"/>
    <ProgressBar x:Name="PreparationBar" Minimum="0" Maximum="100" Height="5"/>
   </StackPanel>
   <Grid x:Name="TaskPanel" Visibility="Collapsed" ColumnSpacing="8">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="TaskText" FontSize="12" VerticalAlignment="Center"/>
    <ProgressBar x:Name="TaskBar" Grid.Column="1" Minimum="0" Maximum="100" VerticalAlignment="Center"/>
    <Button Grid.Column="2" Content="中止" Click="TaskCancelClick" Padding="8,2" FontSize="12"/>
   </Grid>
   <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="StatusLine" FontSize="11" Foreground="#B4B4B4" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxLines="1" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
    <HyperlinkButton x:Name="StatusDetailsButton" Grid.Column="1" Content="状態" FontSize="11" Padding="2,0" MinWidth="0" MinHeight="18" HorizontalAlignment="Right" Click="StatusDetailsClick" AutomationProperties.Name="状態・診断を表示・非表示" ToolTipService.ToolTip="クリックで状態・診断を表示／非表示"/>
   </Grid>
  </StackPanel>
  <Border x:Name="CountdownOverlay" Grid.RowSpan="6" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Width="180" Height="180" CornerRadius="90" Background="#E0202020" BorderBrush="#FF7A7A" BorderThickness="3" Canvas.ZIndex="20" IsHitTestVisible="False">
   <StackPanel VerticalAlignment="Center" Spacing="2"><TextBlock x:Name="CountdownText" Text="3" FontSize="72" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="White"/><TextBlock Text="録画を開始します" FontSize="12" HorizontalAlignment="Center" Foreground="#E0E0E0"/></StackPanel>
  </Border>
  <Canvas x:Name="StatusOverlay" Grid.RowSpan="6" Canvas.ZIndex="10">
   <Border x:Name="StatusDetailsPanel" Visibility="Collapsed" Background="#F0363636" BorderBrush="#858585" BorderThickness="1" CornerRadius="8">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="220" Padding="10,8,22,8">
    <StackPanel Spacing="3">
     <TextBlock Text="状態・診断" FontSize="12" FontWeight="SemiBold"/>
     <TextBlock x:Name="SpeakerStatusText" FontSize="12" Foreground="#C8C8C8" TextWrapping="Wrap" Visibility="Collapsed"/>
     <TextBlock x:Name="StatusText" Text="「開始」または「新規録音」で始めます。" TextWrapping="Wrap" FontSize="12" Foreground="#C8C8C8"/><TextBlock x:Name="BackendText" FontSize="12" Foreground="#C8C8C8" TextWrapping="Wrap"/><TextBlock x:Name="MetricsText" FontSize="11" Foreground="#C8C8C8" TextWrapping="Wrap" Visibility="Collapsed"/>
    </StackPanel>
    </ScrollViewer>
   </Border>
  </Canvas>
 </Grid>
</Window>
