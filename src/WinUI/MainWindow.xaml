<Window x:Class="Locaptio.WinUI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Locaptio.WinUI" Title="Locaptio">
 <Grid x:Name="Root" RequestedTheme="Dark" Background="#363636" Padding="12" RowSpacing="6">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <MenuBar x:Name="HeaderMenu" RequestedTheme="Light" Background="#F5F7FA" Margin="-12,-12,-12,0" Padding="6,0" MinHeight="32" AutomationProperties.Name="メニューバー">
   <MenuBar.Resources><Style TargetType="MenuBarItem"><Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="10,4"/><Setter Property="MinHeight" Value="30"/></Style></MenuBar.Resources>
   <MenuBarItem Title="ファイル(F)">
    <MenuFlyoutItem Text="テキストを保存…" Click="SaveClick"/>
    <MenuFlyoutItem Text="全文をコピー" Click="CopyTranscriptClick"/>
    <MenuFlyoutSeparator/>
    <MenuFlyoutItem Text="終了" Click="CloseClick"/>
   </MenuBarItem>
   <MenuBarItem Title="聞き取り(T)">
    <MenuFlyoutItem Text="開始" Click="StartClick"/>
    <MenuFlyoutItem Text="停止" Click="StopClick"/>
    <MenuFlyoutItem Text="字幕をクリア" Click="ClearClick"/>
   </MenuBarItem>
   <MenuBarItem Title="設定(S)">
    <MenuFlyoutItem Text="設定を開く…" Click="SettingsClick"/>
   </MenuBarItem>
   <MenuBarItem Title="ヘルプ(H)">
    <MenuFlyoutItem Text="モデルの説明" Click="ModelHelpClick"/>
    <MenuFlyoutItem Text="更新を確認" Click="CheckUpdatesClick"/>
    <MenuFlyoutItem Text="このアプリについて" Click="AboutClick"/>
   </MenuBarItem>
  </MenuBar>
  <StackPanel Grid.Row="1" Spacing="6">
  <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><local:DownwardSelector x:Name="ModeSelector" Width="260" HorizontalAlignment="Left" SelectionChanged="ModeChanged" AutomationProperties.Name="字幕モード" ToolTipService.ToolTip="切り替えると字幕履歴をクリアします。必要なテキストは切替前に保存してください。録音は継続します。"></local:DownwardSelector><local:DownwardSelector x:Name="AudioSelector" Grid.Column="1" HorizontalAlignment="Stretch" MaxWidth="500" SelectionChanged="AudioChanged" DropDownOpened="AudioMenuOpened" AutomationProperties.Name="音声入力" ToolTipService.ToolTip="PC全体・マイク・PC内音声＋マイク同時入力・指定アプリの音声。同時入力の文字起こしはWhisperを使用します。切替時は字幕履歴をクリアし、録音は新しいファイルへ分割します。"/></Grid>
  <StackPanel Orientation="Horizontal" Spacing="8">
   <StackPanel.Resources>
    <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}"><Setter Property="MinHeight" Value="30"/><Setter Property="Padding" Value="10,4"/><Setter Property="FontSize" Value="14"/><Setter Property="CornerRadius" Value="4"/></Style>
    <Style TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}"><Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="30"/><Setter Property="FontSize" Value="14"/><Setter Property="CornerRadius" Value="4"/></Style>
   </StackPanel.Resources>
   <Button x:Name="StartButton" Content="Start" Click="StartClick"/><Button x:Name="StopButton" Content="Stop" Click="StopClick" IsEnabled="False"/><Button Content="Clear" Click="ClearClick"/>
   <Button x:Name="CaptionButton" Content="字幕" Click="CaptionClick" ToolTipService.ToolTip="キャプションだけのウィンドウを開閉します。移動は字幕の背景をドラッグしてください。"/>
   <Button x:Name="SaveButton" Content="テキスト保存" Click="SaveClick" IsEnabled="False"/><CheckBox x:Name="RecordToggle" Content="録音" Checked="RecordChanged" Unchecked="RecordChanged" AutomationProperties.Name="録音" ToolTipService.ToolTip="ファイル名と保存先を指定し、保存を確定すると録音と文字起こしを開始します。キャンセルでは開始しません。外すと録音だけ停止します。"/>
   <CheckBox x:Name="AiCorrectionToggle" Content="AI補正" Click="AiCorrectionChanged" AutomationProperties.Name="文字起こしをAIで補正" ToolTipService.ToolTip="文字起こしをローカルAIで補正します。Windows連携は即時反映、Whisperは次回Startから。LLM環境・モデルが必要です。"/>
  </StackPanel></StackPanel>
  <Grid x:Name="RecordingIndicator" Grid.Row="2" Visibility="Collapsed" ColumnSpacing="8">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <TextBlock Text="● 録音中" Foreground="#FF8F8F"/>
   <TextBlock x:Name="RecordingClock" Grid.Column="1" FontFamily="Consolas" Foreground="#FF8F8F"/>
   <TextBlock x:Name="RecordingText" Grid.Column="2" Foreground="#FF8F8F" TextTrimming="CharacterEllipsis"/>
  </Grid>
  <Grid x:Name="Header" Grid.Row="3" ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock x:Name="EnglishHeader" Text="English" Foreground="#C8C8C8"/><TextBlock x:Name="JapaneseHeader" Grid.Column="1" Text="日本語" Foreground="#C8C8C8"/></Grid>
  <ListView x:Name="CaptionList" Grid.Row="4" SelectionMode="None" IsItemClickEnabled="False" Padding="0" ContainerContentChanging="CaptionContainerChanging" Loaded="CaptionListLoaded" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
   <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel ItemsUpdatingScrollMode="KeepItemsInView"/></ItemsPanelTemplate></ListView.ItemsPanel>
   <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="MinHeight" Value="0"/><Setter Property="IsTabStop" Value="False"/></Style></ListView.ItemContainerStyle>
   <ListView.ItemTemplate><DataTemplate><Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{Binding English}" TextWrapping="Wrap" IsTextSelectionEnabled="False" SelectionChanged="CaptionSelectionChanged" Unloaded="CaptionTextUnloaded"/><TextBlock Grid.Column="1" Text="{Binding Japanese}" TextWrapping="Wrap" IsTextSelectionEnabled="False" SelectionChanged="CaptionSelectionChanged" Unloaded="CaptionTextUnloaded"/></Grid></DataTemplate></ListView.ItemTemplate>
  </ListView>
  <Button x:Name="ResumeHistoryButton" Grid.Row="4" Content="最新へ" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,12" Click="ResumeHistoryClick" ToolTipService.ToolTip="最新の字幕へ移動し、自動スクロールを再開します。"/>
  <StackPanel Grid.Row="5" Spacing="3">
   <InfoBar x:Name="UpdateNotice" Severity="Informational" IsOpen="False" IsClosable="True" Title="アプリの更新"/>
   <InfoBar x:Name="WindowsCaptionWarning" Severity="Warning" IsOpen="False" IsClosable="False" Title="Windowsライブキャプションとの接続が切れました"/>
   <InfoBar x:Name="WindowsLanguageWarning" Severity="Warning" IsOpen="False" IsClosable="True" Title="Windows字幕の言語を確認してください"/>
   <StackPanel x:Name="PreparationPanel" Spacing="3" Visibility="Collapsed" ToolTipService.ToolTip="割合は完了した準備工程の割合です。残り時間やNPUコンパイル内部の進捗を推測した値ではありません。">
    <TextBlock x:Name="PreparationText" FontSize="12" Foreground="#FFFFFF" TextWrapping="Wrap"/>
    <ProgressBar x:Name="PreparationBar" Minimum="0" Maximum="100" Height="5"/>
   </StackPanel>
   <HyperlinkButton x:Name="StatusDetailsButton" Content="状態" FontSize="11" Padding="2,0" MinWidth="0" MinHeight="18" HorizontalAlignment="Right" Click="StatusDetailsClick" AutomationProperties.Name="状態・診断を表示・非表示" ToolTipService.ToolTip="クリックで状態・診断を表示／非表示"/>
  </StackPanel>
  <Canvas x:Name="StatusOverlay" Grid.RowSpan="6" Canvas.ZIndex="10">
   <Border x:Name="StatusDetailsPanel" Visibility="Collapsed" Background="#F0363636" BorderBrush="#858585" BorderThickness="1" CornerRadius="8">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="220" Padding="10,8,22,8">
    <StackPanel Spacing="3">
     <TextBlock Text="状態・診断" FontSize="12" FontWeight="SemiBold"/>
     <TextBlock x:Name="SpeakerStatusText" FontSize="12" Foreground="#C8C8C8" TextWrapping="Wrap" Visibility="Collapsed"/>
     <TextBlock x:Name="StatusText" Text="Startまたは録音チェックで開始します。" TextWrapping="Wrap" FontSize="12" Foreground="#C8C8C8"/><TextBlock x:Name="BackendText" FontSize="12" Foreground="#C8C8C8" TextWrapping="Wrap"/><TextBlock x:Name="MetricsText" FontSize="11" Foreground="#C8C8C8" TextWrapping="Wrap" Visibility="Collapsed"/>
    </StackPanel>
    </ScrollViewer>
   </Border>
  </Canvas>
 </Grid>
</Window>
