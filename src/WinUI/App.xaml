<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Locaptio.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Locaptio.WinUI">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <!-- Static check mark: the animated one can stay on its dash frame ("—"). See CheckBoxGlyph. -->
            <Style TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}">
                <Setter Property="local:CheckBoxGlyph.Static" Value="True"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
